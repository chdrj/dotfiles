# ── Kick off the event-driven clock updater ─────────────────
pkill -f "$PLUGIN_DIR/clock_updater.sh" 2>/dev/null
"$PLUGIN_DIR/clock_updater.sh" >/dev/null 2>&1 &
disown

# ── Force first render ───────────────────────────────────────
sketchybar --update
