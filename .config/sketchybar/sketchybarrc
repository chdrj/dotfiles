# ─────────────────────────────────────────────────────────────
#  Neon Glass Terminal — sketchybar config
#  Edge-to-edge flush bar fused to the top, smoked-glass with a
#  hairline underline, per-metric accents, Nerd Font variants.
# ─────────────────────────────────────────────────────────────

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

source "$CONFIG_DIR/colors.sh"

# ── Bar ──────────────────────────────────────────────────────
# Flush, not floating: zero margin/offset and square corners weld
# the bar to the top edge.
#
# sketchybar's bar border draws as a full rectangle (all 4 edges),
# with no per-side control. To keep ONLY the bottom hairline we push
# the other three edges off-screen:
#   y_offset=-1 + height+1  → top border clipped above the screen
#   margin=-1               → left/right borders clipped past the sides
# Net drawn area is identical; only the bottom edge remains visible.
sketchybar --bar \
  position=top \
  height=35 \
  corner_radius=0 \
  margin=-1 \
  y_offset=-1 \
  blur_radius=30 \
  color=$BAR_COLOR \
  border_color=$BAR_UNDERLINE \
  border_width=1 \
  shadow=off \
  sticky=on \
  padding_left=14 \
  padding_right=14

# ── Defaults applied to every subsequent item ───────────────
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:14.0"
  label.font="Cascadia Code:SemiBold:13.0"
  icon.color=$WHITE
  label.color=$WHITE
  icon.padding_left=6
  icon.padding_right=4
  label.padding_left=2
  label.padding_right=6
  background.height=22
  background.corner_radius=9
  background.border_width=0
  background.drawing=off
  updates=on
)
sketchybar --default "${default[@]}"

# ── Aerospace workspace event ────────────────────────────────
sketchybar --add event aerospace_workspace_change

# ── Spotify event (broadcast by Spotify on play/pause/skip) ──
# sketchybar --add event spotify_change com.spotify.client.PlaybackStateChanged

# ── Workspace pills (per monitor) ────────────────────────────
for monitor in $(aerospace list-monitors --format "%{monitor-appkit-nsscreen-screens-id}"); do
  for sid in $(aerospace list-workspaces --monitor "$monitor"); do
    display_id="1"
    case "$sid" in
      [B-Z]) display_id="2" ;;
    esac

    sketchybar --add item space.$sid left \
      --set space.$sid display="$display_id" \
      --subscribe space.$sid aerospace_workspace_change \
      --set space.$sid \
        drawing=on \
        background.drawing=on \
        background.color=$WS_INACTIVE_BG \
        background.corner_radius=8 \
        background.height=22 \
        background.border_color=$ITEM_BORDER \
        background.border_width=1 \
        icon="$sid" \
        icon.font="Hack Nerd Font:Bold:13.0" \
        icon.color=$WS_INACTIVE_FG \
        icon.padding_left=8 \
        icon.padding_right=8 \
        icon.shadow.drawing=on \
        icon.shadow.color=0x66000000 \
        icon.shadow.distance=2 \
        label.font="sketchybar-app-font:Regular:16.0" \
        label.padding_left=2 \
        label.padding_right=12 \
        label.y_offset=-1 \
        label.shadow.drawing=off \
        click_script="aerospace workspace $sid" \
        script="$CONFIG_DIR/plugins/aerospace.sh $sid"
  done
done

# ── Load workspace icons on startup ──────────────────────────
for monitor in $(aerospace list-monitors); do
  for sid in $(aerospace list-workspaces --monitor "$monitor" --empty no); do
    apps=$(aerospace list-windows --workspace "$sid" | awk -F'|' '{gsub(/^ *| *$/, "", $2); print $2}')

    sketchybar --set space.$sid drawing=on

    icon_strip=" "
    if [ "${apps}" != "" ]; then
      while read -r app; do
        icon_strip+=" $($CONFIG_DIR/plugins/icon_map_fn.sh "$app")"
      done <<<"${apps}"
    else
      icon_strip=""
    fi
    sketchybar --set space.$sid label="$icon_strip"
  done
done

# ── Spacer between workspaces and front_app ──────────────────
sketchybar --add item ws_app_spacer left \
           --set ws_app_spacer \
             icon="" \
             label="" \
             background.drawing=off \
             width=8

# ── Front app capsule ────────────────────────────────────────
source "$ITEM_DIR/front_app.sh"

# ── Right side: clock → memory → battery → wifi → volume ────
# (sketchybar prepends right-side items, so clock ends up rightmost)

sketchybar --add event clock_update

# ── Clock (rightmost capsule) ─────────────────────────────────
sketchybar --add item clock right \
  --set clock \
    padding_left=6 \
    padding_right=6 \
    script="$PLUGIN_DIR/clock.sh" \
    icon="󱑍" \
    icon.padding_left=10 \
    icon.padding_right=6 \
    icon.font="Hack Nerd Font:Bold:14.0" \
    icon.color=$CLOCK_ACCENT \
    label.font="Hack Nerd Font Mono:Bold:13.0" \
    label.color=$CLOCK_ACCENT \
    label.padding_right=12 \
    background.drawing=on \
    background.color=$ITEM_BG_STRONG \
    background.border_color=$ITEM_BORDER \
    background.border_width=1 \
    background.corner_radius=9 \
    background.height=22 \
    width=120 \
  --subscribe clock clock_update system_woke

# ── Battery ──────────────────────────────────────────────────
sketchybar --add item battery right \
  --set battery \
    padding_left=6 \
    padding_right=15 \
    update_freq=120 \
    script="$PLUGIN_DIR/battery.sh" \
    icon.font="Hack Nerd Font:Bold:14.0" \
    icon.padding_left=4 \
    icon.padding_right=4 \
    label.font="Hack Nerd Font:Bold:12.0" \
    label.color=$WHITE \
  --subscribe battery system_woke power_source_change

# ── Wi-Fi ────────────────────────────────────────────────────
sketchybar --add item wifi right \
  --set wifi \
    padding_left=6 \
    padding_right=6 \
    script="$PLUGIN_DIR/wifi.sh" \
    icon=󰖩 \
    icon.font="Hack Nerd Font:Bold:14.0" \
    icon.color=$WIFI_ACCENT \
    icon.padding_left=4 \
    icon.padding_right=4 \
    label.drawing=off \
  --subscribe wifi wifi_change

# ── Volume ───────────────────────────────────────────────────
sketchybar --add item volume right \
  --set volume \
    padding_left=6 \
    padding_right=6 \
    script="$PLUGIN_DIR/volume.sh" \
    icon.font="Hack Nerd Font:Bold:14.0" \
    icon.color=$VOL_ACCENT \
    icon.padding_left=4 \
    icon.padding_right=4 \
    label.font="Hack Nerd Font:Bold:12.0" \
    label.color=$WHITE \
  --subscribe volume volume_change

  # ── Spotify now-playing (right) ──────────────
