# ── Volume ───────────────────────────────────────────────────
sketchybar --add item volume right \
  --set volume \
    script="$PLUGIN_DIR/volume.sh" \
    icon.font="Hack Nerd Font:Bold:15.0" \
    icon.color=$VOL_ACCENT \
    icon.padding_left=6 \
    icon.padding_right=4 \
    label.font="Hack Nerd Font:Bold:12.0" \
    label.color=$WHITE \
  --subscribe volume volume_change

# ── Kick off the event-driven clock updater ─────────────────
pkill -f "$PLUGIN_DIR/clock_updater.sh" 2>/dev/null
"$PLUGIN_DIR/clock_updater.sh" >/dev/null 2>&1 &
disown

# ── Force first render ───────────────────────────────────────
sketchybar --update
