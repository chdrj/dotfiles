#!/bin/bash

options=(
  style=round
  width=5.0
  hidpi=on
  # Active: bright orchid (top-left) flowing into deep electric violet
  # (bottom-right) — diagonal purple gradient across the window.
  active_color="gradient(top_left=0xff8b5cf6,bottom_right=0xff4f46e5)"
  # Inactive: muted, semi-transparent purple-grey so it recedes.
  inactive_color="gradient(top_left=0x99544a85,bottom_right=0x99362c54)"
)

borders "${options[@]}"
