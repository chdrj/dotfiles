# Changing 'yes' to 'titlebar-only' allows macOS to apply corner rounding
hide_window_decorations titlebar-only
window_padding_width 10

# These ensure the titlebar area is invisible/blended
macos_titlebar_color background
macos_show_titlebar  yes
draw_minimize_window_button no
draw_close_window_button no
draw_maximize_window_button no

# --- Appearance ---
background_opacity 0.5
background #000000 

# --- Font Configuration ---
font_family      Virgil 3 YOFF
italic_font      auto
bold_font        auto
bold_italic_font auto
font_size        20.0

# BEGIN_KITTY_THEME
# Tokyo Night Moon
include current-theme.conf
# END_KITTY_THEME